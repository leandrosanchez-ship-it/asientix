# Copiar a .env.local (que .gitignore ya excluye) y completar con los datos
# del proyecto Supabase de Asientix (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para scripts/migraciones que corren del lado del servidor con
# privilegios de administrador (nunca exponer al navegador ni commitear).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
